#!/bin/sh
# ninferno-update: install the newest NInferno release over this one (Linux and WSL 2).
#
#   ninferno-update            say what is new and ask before installing
#   ninferno-update --yes      install without asking (ninferno-ui's Update button)
#   ninferno-update --check    only say whether a newer release is out (exit 0: yes, 1: no)
#   ninferno-update --rollback go back to the version installed before this one
#
# It reads the release manifest (latest.json) and acts on it only when the installed release's own
# installer (share/ninferno/install.sh, which carries the release key) finds it signed by that key.
# The installer then downloads the archive the signed manifest names, checks it against the SHA-256
# the manifest gives and installs it beside the current version; `current` then points at the new
# one. Nothing is fetched to run: a release server that is broken into can neither sign a manifest
# nor hand this script an installer. Running models keep the files they started with; the
# previous version stays for --rollback, older ones are removed.
#
# Environment: NINFERNO_UPDATE_URL (the manifest, default the release server's latest.json),
# NINFERNO_HOME / NINFERNO_BIN as for install.sh.
set -eu
MANIFEST=${NINFERNO_UPDATE_URL:-https://ninferno.brontir.com/releases/latest.json}

say() { printf '%s\n' "$*"; }
die() { printf 'ninferno-update: %s\n' "$*" >&2; exit 1; }

self=$(readlink -f "$0")
version_dir=$(dirname "$(dirname "$self")")      # <home>/ninferno-<version>-linux-x86_64
home=${NINFERNO_HOME:-$(dirname "$version_dir")}
release="$version_dir/share/ninferno/release.json"
[ -f "$release" ] || die "not a release installation ($release missing); update a source build with git"
field() { sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" "$2" | head -1; }
current=$(field version "$release")

# version_newer LATEST CURRENT: exit 0 when LATEST is the newer release, 1 when it is not, 2 when
# LATEST is no release version. The order is semantic versioning's, the one ninferno-ui and
# ninferno-serve use (src/product/update/update_check.cpp, compare_versions): a pre-release sorts
# below its release (0.1.0-rc1 < 0.1.0), rc2 < rc10. A CURRENT that is no release (a build between
# releases) is older than any release.
version_newer() {
  LC_ALL=C awk -v a="$1" -v b="$2" '
    function parse(v,   d, n, i, parts) {
      sub(/^[vV]/, "", v); PRE = ""
      if ((d = index(v, "-")) > 0) {
        PRE = substr(v, d + 1); v = substr(v, 1, d - 1)
        if (PRE == "" || PRE ~ /[^A-Za-z0-9.]/) return 0
      }
      n = split(v, parts, ".")
      if (n < 2 || n > 4) return 0
      for (i = 1; i <= 4; i++) NUM[i] = 0
      for (i = 1; i <= n; i++) {
        if (parts[i] !~ /^[0-9]+$/ || length(parts[i]) > 9) return 0
        NUM[i] = parts[i] + 0
      }
      return 1
    }
    # One dot-separated part of a pre-release label: its word W and trailing number N (-1: none).
    function part(s) {
      if (match(s, /[0-9]+$/) && RLENGTH <= 9) { W = substr(s, 1, RSTART - 1); N = substr(s, RSTART) + 0 }
      else { W = s; N = -1 }
    }
    function prerelease(x, y,   px, py, nx, ny, i, wx, vx) {
      nx = split(x, px, "."); ny = split(y, py, ".")
      for (i = 1; i <= nx && i <= ny; i++) {
        part(px[i]); wx = W; vx = N; part(py[i])
        if (wx != W) return (wx < W) ? -1 : 1
        if (vx != N) return (vx < N) ? -1 : 1
      }
      if (nx == ny) return (x < y) ? -1 : (x == y) ? 0 : 1
      return (nx < ny) ? -1 : 1
    }
    BEGIN {
      if (!parse(a)) exit 2
      for (i = 1; i <= 4; i++) na[i] = NUM[i]
      pa = PRE
      if (!parse(b)) exit 0
      for (i = 1; i <= 4; i++) if (na[i] != NUM[i]) exit (na[i] > NUM[i]) ? 0 : 1
      if (pa == PRE) exit 1
      if (pa == "") exit 0
      if (PRE == "") exit 1
      exit (prerelease(pa, PRE) > 0) ? 0 : 1
    }'
}

mode=ask
case ${1:-} in
  --yes|-y) mode=yes ;;
  --check) mode=check ;;
  --rollback) mode=rollback ;;
  -h|--help) sed -n '2,17s/^# \{0,1\}//p' "$self"; exit 0 ;;
  '') ;;
  *) die "unknown argument $1 (--yes, --check, --rollback)" ;;
esac

if [ "$mode" = rollback ]; then
  previous=$(ls -1dt "$home"/ninferno-*-linux-x86_64* 2>/dev/null | grep -vx "$version_dir" | head -1 || true)
  [ -n "$previous" ] || die "no earlier version is kept in $home"
  # Switched to only when it starts here, as install.sh does for a new release.
  "$previous/bin/ninferno-serve" --version > /dev/null 2>&1 ||
    die "$(basename "$previous") does not start on this machine: nothing changed"
  ln -sfn "$previous" "$home/current"
  bin=${NINFERNO_BIN:-$HOME/.local/bin}
  for exe in "$home/current/bin/"*; do
    case $(basename "$exe") in *-sm[0-9]*) continue ;; esac  # the engines: ninferno-serve starts them
    ln -sf "$exe" "$bin/$(basename "$exe")"
  done
  say "Back to $(basename "$previous")."
  exit 0
fi

command -v curl > /dev/null 2>&1 || die "curl not found"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
installer="$version_dir/share/ninferno/install.sh"
[ -f "$installer" ] || die "$installer is missing: reinstall NInferno"
curl -fsSL --max-time 30 -o "$tmp/latest.json" "$MANIFEST" &&
  curl -fsSL --max-time 30 -o "$tmp/latest.json.sig" "$MANIFEST.sig" || die "cannot read $MANIFEST"
sh "$installer" --verify "$tmp/latest.json" ||
  die "$MANIFEST is not signed by the NInferno release key: nothing installed"
latest=$(field version "$tmp/latest.json")
notes=$(field notes "$tmp/latest.json")
[ -n "$latest" ] || die "$MANIFEST is not a release manifest"

order=0
version_newer "$latest" "$current" || order=$?
[ "$order" != 2 ] || die "$MANIFEST names no release version ($latest)"
if [ "$order" != 0 ]; then
  say "NInferno $current is the newest release."
  [ "$mode" = check ] && exit 1
  exit 0
fi
say "NInferno $latest is available (this is $current)."
[ -n "$notes" ] && say "What changed: $notes"
[ "$mode" = check ] && exit 0
if [ "$mode" = ask ]; then
  printf 'Install it now? [Y/n] '
  read -r answer < /dev/tty || answer=n
  case $answer in [nN]*) say "Not installed."; exit 0 ;; esac
fi

say "Installing NInferno $latest ..."
NINFERNO_MANIFEST=$tmp/latest.json NINFERNO_HOME=$home sh "$installer"

# Keep the new version and the one before it (running models may still use it).
ls -1dt "$home"/ninferno-*-linux-x86_64* 2>/dev/null | tail -n +3 | while read -r old; do
  [ "$(readlink -f "$home/current")" = "$(readlink -f "$old")" ] || rm -rf "$old"
done
say "NInferno $latest is installed; restart ninferno-ui and running models to use it (ninferno-update --rollback goes back)."
