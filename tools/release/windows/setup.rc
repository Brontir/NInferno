#include <windows.h>

1 ICON "ninferno.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NINFERNO_VERSION_NUMBERS
PRODUCTVERSION NINFERNO_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Brontir"
      VALUE "FileDescription", "NInferno Setup"
      VALUE "FileVersion", NINFERNO_VERSION
      VALUE "ProductName", "NInferno"
      VALUE "ProductVersion", NINFERNO_VERSION
      VALUE "OriginalFilename", "NInferno-Setup.exe"
      VALUE "LegalCopyright", "Apache-2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
