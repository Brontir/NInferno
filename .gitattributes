# Text files are LF in the repository and in every checkout (byte-exact fixtures, templates and
# kernels compare across Linux, WSL and Windows); git detects binaries itself.
* text=auto eol=lf
# Preserve repository-pinned upstream sources byte-for-byte; NInferno-owned files retain Git's
# default whitespace checks.
/third_party/spdlog/include/** -whitespace
/third_party/spdlog/src/** -whitespace
# Scripts run under bash or python on Linux, WSL and Git Bash: LF whatever the checkout's platform
# (a CRLF script fails with "$'\r': command not found").
*.sh text eol=lf
*.py text eol=lf
tools/release/ninferno-start text eol=lf
tools/release/ninferno-update text eol=lf
