# ninferno_generate_board_registry(JSON_FILE OUT_FILE): writes the rows of the board registry
# (core/board_registry.h) from the PCI-ID reference table, one initializer per row:
#
#   {0x2B85u, 12, 0, 170, 96, 512, 28.0, 2407, false},   // pci id, cc major, minor, SMs, L2 MiB,
#                                                   // bus bits, Gbps per pin, boost MHz, mma_slow
#
# in the table's order. A row without l2_mib gets 0 (unknown, as Board spells it). OUT_FILE is
# rewritten only when its text changes, so an unchanged table rebuilds nothing.
function(ninferno_generate_board_registry json_file out_file)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${json_file})
  file(READ ${json_file} text)
  string(JSON count LENGTH "${text}" gpus)
  math(EXPR last "${count} - 1")
  set(rows "// Generated by CMake from src/core/data/gpu_facts.json; edit that file, not this one.\n")
  foreach(i RANGE ${last})
    string(JSON id GET "${text}" gpus ${i} id)
    string(JSON cc GET "${text}" gpus ${i} cc)
    string(JSON sms GET "${text}" gpus ${i} sms)
    string(JSON bus GET "${text}" gpus ${i} bus_bits)
    string(JSON gbps GET "${text}" gpus ${i} gbps)
    string(JSON boost GET "${text}" gpus ${i} boost_mhz)
    string(JSON l2 ERROR_VARIABLE l2_error GET "${text}" gpus ${i} l2_mib)
    if(NOT l2_error STREQUAL "NOTFOUND")
      set(l2 0)
    endif()
    string(JSON slow ERROR_VARIABLE slow_error GET "${text}" gpus ${i} mma_slow)
    if(NOT slow_error STREQUAL "NOTFOUND" OR NOT slow)
      set(slow false)
    else()
      set(slow true)
    endif()
    math(EXPR major "${cc} / 10")
    math(EXPR minor "${cc} % 10")
    string(APPEND rows "{${id}u, ${major}, ${minor}, ${sms}, ${l2}, ${bus}, ${gbps}, ${boost}, ${slow}},\n")
  endforeach()
  set(old "")
  if(EXISTS ${out_file})
    file(READ ${out_file} old)
  endif()
  if(NOT old STREQUAL rows)
    file(WRITE ${out_file} "${rows}")
  endif()
endfunction()

# ninferno_generate_arch_registry(JSON_FILE OUT_FILE): writes the rows of the architecture table
# (core/arch_registry.h) from the "archs" array of the same file, one initializer per row, in the
# file's order:
#
#   {120, 101376, 102400, 1024, 1536, 32, 65536},   // cc, shared per block opt-in and per SM
#                                                   // (bytes), reserved per block, max threads
#                                                   // and blocks per SM, registers per SM
#
# The row with cc 0 is the one an unlisted capability gets. Rewritten only when its text changes.
function(ninferno_generate_arch_registry json_file out_file)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${json_file})
  file(READ ${json_file} text)
  string(JSON count LENGTH "${text}" archs)
  math(EXPR last "${count} - 1")
  set(rows "// Generated by CMake from src/core/data/gpu_facts.json; edit that file, not this one.\n")
  foreach(i RANGE ${last})
    foreach(key cc smem_per_block_optin_kib smem_per_sm_kib smem_reserved_per_block
                max_threads_per_sm max_blocks_per_sm registers_per_sm)
      string(JSON ${key} GET "${text}" archs ${i} ${key})
    endforeach()
    math(EXPR block "${smem_per_block_optin_kib} * 1024")
    math(EXPR sm "${smem_per_sm_kib} * 1024")
    string(APPEND rows "{${cc}, ${block}, ${sm}, ${smem_reserved_per_block}, "
                       "${max_threads_per_sm}, ${max_blocks_per_sm}, ${registers_per_sm}},\n")
  endforeach()
  set(old "")
  if(EXISTS ${out_file})
    file(READ ${out_file} old)
  endif()
  if(NOT old STREQUAL rows)
    file(WRITE ${out_file} "${rows}")
  endif()
endfunction()
