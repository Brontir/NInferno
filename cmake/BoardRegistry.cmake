# ninferno_generate_board_registry(JSON_FILE OUT_FILE): writes the rows of the board registry
# (core/board_registry.h) from the PCI-ID reference table, one initializer per row:
#
#   {0x2B85u, 12, 0, 170, 96, 512, 28.0, 2407},   // pci id, cc major, minor, SMs, L2 MiB,
#                                                   // bus bits, Gbps per pin, boost MHz
#
# in the table's order. A row without l2_mib gets 0 (unknown, as Board spells it). OUT_FILE is
# rewritten only when its text changes, so an unchanged table rebuilds nothing.
function(ninferno_generate_board_registry json_file out_file)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${json_file})
  file(READ ${json_file} text)
  string(JSON count LENGTH "${text}" gpus)
  math(EXPR last "${count} - 1")
  set(rows "// Generated by CMake from src/core/data/gpu_facts.json; edit that file, not this one.\n")
  foreach(i RANGE ${last})
    string(JSON id GET "${text}" gpus ${i} id)
    string(JSON cc GET "${text}" gpus ${i} cc)
    string(JSON sms GET "${text}" gpus ${i} sms)
    string(JSON bus GET "${text}" gpus ${i} bus_bits)
    string(JSON gbps GET "${text}" gpus ${i} gbps)
    string(JSON boost GET "${text}" gpus ${i} boost_mhz)
    string(JSON l2 ERROR_VARIABLE l2_error GET "${text}" gpus ${i} l2_mib)
    if(NOT l2_error STREQUAL "NOTFOUND")
      set(l2 0)
    endif()
    math(EXPR major "${cc} / 10")
    math(EXPR minor "${cc} % 10")
    string(APPEND rows "{${id}u, ${major}, ${minor}, ${sms}, ${l2}, ${bus}, ${gbps}, ${boost}},\n")
  endforeach()
  set(old "")
  if(EXISTS ${out_file})
    file(READ ${out_file} old)
  endif()
  if(NOT old STREQUAL rows)
    file(WRITE ${out_file} "${rows}")
  endif()
endfunction()
